---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot__identity">
    <span class="foot__motto">still curious.</span>

    <span>
      © {year} sami dj
    </span>

    <span class="foot__license">
      site code: all rights reserved · writing: <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" target="_blank" rel="license noopener">CC BY-NC-ND</a>
    </span>
  </div>

  <div class="foot__links">
    <a href="https://github.com/caspr">github</a>
    <span aria-hidden="true">·</span>
    <a href="/rss.xml">rss</a>
    <span aria-hidden="true">·</span>
    <span>built with Astro</span>
  </div>

  <a href="#top" class="foot__top">
    ↑ top
  </a>
</footer>

<style>
  .foot {
    grid-area: foot;
    border-top: 1px solid var(--line);
    padding: 1.5rem;

    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;

    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--ink-soft);
  }

  .foot__identity {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    justify-self: start;
  }

  .foot__motto {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
  }

  .foot__license {
    opacity: 0.85;
  }

  .foot__links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: center;
  }

  .foot a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }

  .foot a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .foot__top {
    white-space: nowrap;
    justify-self: end;
  }

  @media (max-width: 600px) {
    .foot {
      grid-template-columns: 1fr;
      justify-items: flex-start;
    }

    .foot__identity,
    .foot__links,
    .foot__top {
      justify-self: start;
    }

    .foot__links {
      flex-wrap: wrap;
    }

    .foot__top {
      margin-top: 0.5rem;
    }
  }
</style>
