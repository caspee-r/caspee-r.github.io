---
import BaseLayout from '../layouts/BaseLayout.astro';

/*
Project shape:
  number, name, year, type, description,
  tags, status, href, source
*/

const projects = [
  {
    number: '01',
    name: 'LifeLink',
    year: '2026',
    type: 'WEB APPLICATION',
    description:
      'A platform for coordinating organ donation and connecting donors with recipients.',
    tags: ['Python', 'Flask', 'Web'],
    status: 'active',
    featured: true,
    href: '#',
    source: '#',
  },
  {
    number: '02',
    name: 'Terminal Snake',
    year: '2025',
    type: 'GAME',
    description:
      'A terminal implementation of Snake built around raw input, a game loop, and ncurses.',
    tags: ['C', 'Low-Level', 'TUI'],
    status: 'archived',
    href: '#',
    source: '#',
  },
  {
    number: '03',
    name: '8086 Experiments',
    year: '2025',
    type: 'LOW LEVEL',
    description:
      'Experiments with the 8086, BIOS interrupts, VGA graphics, boot sectors, and real-mode programming.',
    tags: ['Assembly', '8086', 'BIOS', 'VGA'],
    status: 'active',
    href: '#',
    source: '#',
  },
];

const filters = ['ALL', 'WEB', 'SYSTEMS', 'TOOLS', 'EXPERIMENTS'];
---

<BaseLayout
  title="Projects — Sami Dj"
  description="A collection of software, experiments, and things I've built."
>

  <div class="projects">

    <header class="projects__header">
      <span class="index">2</span>
      <span class="annot">projects.log</span>

      <h1>Things I've built,<br /><em>broken,</em> and fixed.</h1>

      <p>
        A collection of software, experiments, and rabbit holes
        I've followed far enough to turn them into something.
      </p>
    </header>


    <nav class="filters" aria-label="Project filters">
      {filters.map((filter, index) => (
        <button
          class:list={{ active: index === 0 }}
          data-filter={filter}
        >
          {filter}
        </button>
      ))}
    </nav>

    <section class="archive" aria-label="Projects">

      {projects.map((project) => (
        <article
          class:list={{
            project: true,
            'project--featured': project.featured,
          }}
          data-category={
            project.type === 'WEB APPLICATION'
              ? 'WEB'
              : project.type === 'LOW LEVEL'
                ? 'SYSTEMS'
                : project.type === 'LIBRARY'
                  ? 'TOOLS'
                  : 'EXPERIMENTS'
          }
        >

          <div class="project__number">
            {project.number}
          </div>

          <div class="project__content">

            <div class="project__top">
              <span class="project__type">
                {project.type}
              </span>

              <span class="project__year">
                {project.year}
              </span>
            </div>

            <div class="project__heading">
              <h2>{project.name}</h2>

              <span
                class:list={{
                  status: true,
                  [`status--${project.status}`]: true,
                }}
              >
                <i></i>
                {project.status}
              </span>
            </div>

            <p class="project__description">
              {project.description}
            </p>

            <div class="project__bottom">

              <div class="tags">
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>

              <div class="project__links">
                <a href={project.source} aria-label={`Source code for ${project.name}`}>
                  source ↗
                </a>

                {project.href !== '#' && (
                  <a href={project.href}>
                    case study ↗
                  </a>
                )}
              </div>

            </div>

          </div>
        </article>
      ))}

    </section>


    <footer class="projects__footer">
      <span class="annot">end of archive</span>

      <p>
        More experiments live in my
        <a href="https://github.com/caspee-r">GitHub</a>.
      </p>
    </footer>

  </div>

</BaseLayout>


<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const projects = document.querySelectorAll<HTMLElement>('.project');

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;

      filters.forEach((item) => item.classList.remove('active'));
      button.classList.add('active');

      projects.forEach((project) => {
        const category = project.dataset.category;

        project.hidden =
          filter !== 'ALL' && category !== filter;
      });
    });
  });
</script>


<style>
  .projects {
    width: 100%;
  }

  /* ───────────────── Header ───────────────── */

  .projects__header {
    padding: 1rem 0 3.5rem;
    border-bottom: 1px solid var(--line);
  }

  .projects__header h1 {
    margin: 0;
    font-size: clamp(2.6rem, 7vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 600;
  }

  .projects__header h1 em {
    color: var(--accent);
    font-weight: 400;
  }

  .projects__header p {
    max-width: 42ch;
    margin: 1.75rem 0 0;
    color: var(--ink-soft);
  }

  .index {
    margin-top: 0.7rem;
    font-family: monospace;
    font-size: 0.7rem;
    opacity: 0.4;
  }
  /* ───────────────── Filters ───────────────── */

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .filters button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .filters button::before {
    content: '[';
    margin-right: 0.25rem;
    opacity: 0;
  }

  .filters button::after {
    content: ']';
    margin-left: 0.25rem;
    opacity: 0;
  }

  .filters button:hover,
  .filters button.active {
    color: var(--accent);
  }

  .filters button.active::before,
  .filters button.active::after {
    opacity: 1;
    color: var(--mark);
  }


  /* ───────────────── Archive ───────────────── */

  .archive {
    border-bottom: 1px solid var(--line);
  }

  .project {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.25rem;
    padding: 2.25rem 0;
    border-bottom: 1px solid var(--line);
  }

  .project:last-child {
    border-bottom: 0;
  }

  .project[hidden] {
    display: none;
  }

  .project__number {
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--mark);
  }

  .project__content {
    min-width: 0;
  }

  .project__top,
  .project__heading,
  .project__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .project__type,
  .project__year {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.035em;
    color: var(--ink-soft);
  }

  .project__year {
    white-space: nowrap;
  }

  .project__heading {
    align-items: baseline;
    margin-top: 0.65rem;
  }

  .project__heading h2 {
    margin: 0;
    font-size: 1.75rem;
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .project--featured .project__heading h2 {
    font-size: 2.2rem;
    color: var(--accent);
  }


  /* ───────────────── Status ───────────────── */

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--ink-soft);
  }

  .status i {
    width: 5px;
    height: 5px;
    display: block;
    border-radius: 50%;
    background: var(--ink-soft);
  }

  .status--active i {
    background: var(--accent);
  }

  .status--maintained i {
    background: var(--mark);
  }


  /* ───────────────── Description ───────────────── */

  .project__description {
    max-width: 48ch;
    margin: 0.85rem 0 1.25rem;
    color: var(--ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
  }


  /* ───────────────── Bottom ───────────────── */

  .project__bottom {
    align-items: flex-end;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tags span {
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--ink-soft);
  }

  .project__links {
    display: flex;
    gap: 1rem;
    flex-shrink: 0;
  }

  .project__links a {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.15rem;
  }

  .project__links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }


  /* ───────────────── Footer ───────────────── */

  .projects__footer {
    padding: 2.5rem 0 0;
  }

  .projects__footer p {
    margin: 0.75rem 0 0;
    color: var(--ink-soft);
  }

  .projects__footer a {
    color: var(--accent);
  }


  /* ───────────────── Mobile ───────────────── */

  @media (max-width: 600px) {
    .projects__header {
      padding-bottom: 2.75rem;
    }

    .project {
      grid-template-columns: 2rem 1fr;
      gap: 0.75rem;
    }

    .project__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.5rem;
    }

    .project__heading h2,
    .project--featured .project__heading h2 {
      font-size: 1.55rem;
    }

    .project__bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .project__links {
      margin-top: 0.5rem;
    }
  }
</style>
