      clear: right;
      width: 12rem;
      max-height: none;
      overflow: visible;
      opacity: 1;
      margin: 0.15rem -14rem 1rem 0;
      padding: 0.6rem 0.75rem;
      font-size: 0.72rem;
      line-height: 1.6;
      background: var(--paper-raised);
      border: 1px solid var(--line);
      border-left: 2px solid var(--mark);
      transition: none;
    }
     .article-content :global(.sidenote-toggle) {
       cursor: default;
       /*
       * Blocks pointer/touch activation of the paired label.
       * Keyboard (Tab + Space) is separately neutered by the
       * identical :checked styling above, since pointer-events
       * has no effect on keyboard-triggered state changes.
       */
       pointer-events: none;
     }
   }
   .article-content :global(pre) {
     overflow-x: auto;
     margin:
      1.5rem 0;
     padding: 1rem;
     border:
      1px solid var(--line);
     background:
       var(--paper-raised);
     font-size: 0.8rem;
     line-height: 1.6;
   }
   .article-content :global(code) {
     font-family: var(--font-mono);
     font-size: 0.85em;
     padding: 0.15em 0.4em;
     border: 1px solid var(--line);
     border-radius: 3px;
     background: var(--paper-raised);
     color: var(--mark);
   }
   /*
   * Block code (inside <pre>) already has its own frame — undo
