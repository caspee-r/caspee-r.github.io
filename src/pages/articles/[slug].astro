---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculateReadingTime } from '../../lib/readingTime';
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: {
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const readingTime = calculateReadingTime(article.body);
/*
 * The TOC is generated by Org and stored in the
 * article frontmatter.
 *
 * Expected shape:
 *
 * toc:
 *   - title: "The Idea Behind Interrupts"
 *     id: "the-idea-behind-interrupts"
 *     level: 1
 *
 *   - title: "Normal Device Events"
 *     id: "normal-device-events"
 *     level: 2
 */
const toc = article.data.toc ?? [];
const tags = article.data.tags ?? [];
/*
 * Optional list of places this article is also published,
 * e.g. Medium, Substack, dev.to.
 *
 * Expected shape:
 *
 * externalLinks:
 *   - label: "Medium"
 *     url: "https://medium.com/@you/your-article"
 */
const externalLinks = article.data.externalLinks ?? [];
---
<BaseLayout
  title={`${article.data.title}   Sami Dj`}
  description={article.data.description}
>
  <article class="article-page">
    <!-- =====================================================
    ARTICLE HEADER
    ===================================================== -->
    <header class="article-header">
      <div class="article-header__category">
        {article.data.category}
      </div>
      <h1>
        {article.data.title}
      </h1>
      {
        article.data.description && (
          <p class="article-header__description">
            {article.data.description}
          </p>
        )
      }
      <div class="article-header__meta">
        <time datetime={String(article.data.date)}>
          {new Date(article.data.date).toLocaleDateString('en', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
          }).toUpperCase()}
        </time>
        <span class="meta-separator">�</span>
        <span>
          {readingTime} min read
        </span>
      </div>
      {
        externalLinks.length > 0 && (
          <div class="article-header__external">
            <span class="article-header__external-label">
              Also on
            </span>
            {
externalLinks.map((link, index) => (
  <>
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="article-header__external-link"
    >
      {link.label}
    </a>

    {index < externalLinks.length - 1 && (
      <span class="meta-separator"> </span>
    )}
  </>
))
            }
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="article-header__tags">
            {
              tags.map((tag) => (
<a
                  href={`/articles/?tag=${encodeURIComponent(tag)}`}
                  class="article-tag"
                >
                  #{tag}
                </a>
              ))
            }
          </div>
        )
      }
    </header>
    <hr class="article-divider" />
    <!-- =====================================================
    ARTICLE CONTENT
    ===================================================== -->
    <div class="article-layout">
      <!-- ===================================================
      TABLE OF CONTENTS
      =================================================== -->
      {
        toc.length > 0 && (
          <aside class="toc" aria-label="Table of contents">
            <button
              class="toc__toggle"
              type="button"
              aria-expanded="false"
              aria-label="Toggle table of contents"
            >
              <span class="toc__markers" aria-hidden="true">
                {
                  toc.map((_, index) => (
                    <span
                      class:list={{
                        "toc__marker": true,
                        "toc__marker--c1": index % 2 === 0,
                        "toc__marker--c2": index % 2 !== 0,
                      }}
                    />
                  ))
                }
              </span>
            </button>
            <nav class="toc__panel">
              <div class="toc__title">
                contents
              </div>
              <ol>
                {
                  toc.map((item) => (
                    <li
                      class:list={{
                        "toc__item": true,
                        [`toc__item--level-${item.level ?? 1}`]: true,
                      }}
                    >
                      <a href={`#${item.id}`}>
                        {item.title}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </aside>
        )
      }
      <!-- ===================================================
      CONTENT
      =================================================== -->
      <div class="article-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
<script>
  /*
   * =========================================================
   * TABLE OF CONTENTS
   * =========================================================
   */
  const toc =
    document.querySelector<HTMLElement>('.toc');
  const toggle =
    document.querySelector<HTMLButtonElement>('.toc__toggle');
  const tocPanel =
    document.querySelector<HTMLElement>('.toc__panel');

  if (toc && toggle && tocPanel) {
    /*
     * -------------------------------------------------------
     * Open / close
     * -------------------------------------------------------
     */
    toggle.addEventListener('click', () => {
      const open =
        toc.classList.toggle('is-open');
      toggle.setAttribute(
        'aria-expanded',
        String(open)
      );
    });

    /*
     * -------------------------------------------------------
     * Close when clicking outside
     * -------------------------------------------------------
     */
    document.addEventListener('click', (event) => {
      if (!toc.contains(event.target as Node)) {
        toc.classList.remove('is-open');
        toggle.setAttribute(
          'aria-expanded',
          'false'
        );
      }
    });

    /*
     * -------------------------------------------------------
     * Compute how much space the fixed/sticky navbar
     * actually needs right now, instead of trusting a
     * hardcoded magic number that can drift out of sync
     * with the real navbar height.
     *
     * NOTE: update the selector below to match your
     * BaseLayout's navbar markup if it differs.
     * -------------------------------------------------------
     */
    function getNavOffset(): number {
      const nav =
        document.querySelector<HTMLElement>(
          '.navbar, header nav, [data-navbar]'
        );
      const height =
        nav?.getBoundingClientRect().height ?? 96;
      return height + 16; // small breathing room
    }

    function scrollToHeading(
      target: HTMLElement,
      smooth = true
    ) {
      const top =
        target.getBoundingClientRect().top +
        window.scrollY -
        getNavOffset();
      window.scrollTo({
        top,
        behavior: smooth ? 'smooth' : 'auto',
      });
    }

    /*
     * -------------------------------------------------------
     * Find headings represented by the TOC.
     * -------------------------------------------------------
     */
    const links =
      Array.from(
        tocPanel.querySelectorAll<HTMLAnchorElement>('a')
      );
    const headings =
      links
        .map((link) => {
        const id =
          link
            .getAttribute('href')
            ?.slice(1);
        return id
          ? document.getElementById(id)
          : null;
      })
        .filter(
          (heading): heading is HTMLElement =>
            heading !== null
        );

    /*
     * -------------------------------------------------------
     * Clicking a TOC link: scroll to the heading ourselves
     * with the correct navbar offset, instead of relying on
     * the browser's native #hash jump.
     *
     * Also closes the panel after selecting a heading.
     * -------------------------------------------------------
     */
    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id =
          link
            .getAttribute('href')
            ?.slice(1);
        const target =
          id ? document.getElementById(id) : null;

        if (target) {
          event.preventDefault();
          scrollToHeading(target);
          history.pushState(null, '', `#${id}`);
        }

        toc.classList.remove('is-open');
        toggle.setAttribute(
          'aria-expanded',
          'false'
        );
      });
    });

    /*
     * -------------------------------------------------------
     * Landed directly on a URL that already has a hash:
     * correct the scroll position once layout has settled,
     * since the browser's initial jump ignores our offset.
     * -------------------------------------------------------
     */
    if (location.hash) {
      const initialTarget =
        document.getElementById(location.hash.slice(1));
      if (initialTarget) {
        requestAnimationFrame(() =>
          scrollToHeading(initialTarget, false)
        );
      }
    }

    /*
     * -------------------------------------------------------
     * Active heading
     * -------------------------------------------------------
     */
    if (headings.length > 0) {
      function updateActiveHeading() {
        const offset = getNavOffset();
        let active =
          headings[0];
        for (const heading of headings) {
          const top =
            heading.getBoundingClientRect().top;
          if (top <= offset) {
            active = heading;
          } else {
            break;
          }
        }
        links.forEach((link) => {
          const id =
            link
              .getAttribute('href')
              ?.slice(1);
          link.classList.toggle(
            'active',
            id === active.id
          );
        });
      }

      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateActiveHeading();
            ticking = false;
          });
        },
        { passive: true }
      );

      updateActiveHeading();
    }
  }

  /*
   * =========================================================
   * HEADING COPY-LINK (underline sweep)
   *
   * Clicking a heading copies a direct link to it. The only
   * feedback is a thin underline (matching that heading's
   * bar color) that sweeps under the heading text and fades
   * — no button, no icon, no tooltip.
   * =========================================================
   */
  const copyableHeadings =
    document.querySelectorAll<HTMLElement>(
      '.article-content h1[id], .article-content h2[id], .article-content h3[id], .article-content h4[id]'
    );

  copyableHeadings.forEach((heading) => {
    /*
     * Wrap the heading's existing content in a span so the
     * underline can be scoped to just the text width, rather
     * than stretching across the whole heading's flex box.
     */
    const span = document.createElement('span');
    span.className = 'heading-text';
    while (heading.firstChild) {
      span.appendChild(heading.firstChild);
    }
    heading.appendChild(span);

    heading.tabIndex = 0;
    heading.setAttribute('role', 'button');
    const label =
      heading.textContent?.trim() ?? 'section';
    heading.setAttribute(
      'aria-label',
      `Copy link to "${label}"`
    );

    let copyTimeout: number | undefined;

    async function copyHeadingLink() {
      const url =
        `${location.origin}${location.pathname}#${heading.id}`;

      try {
        await navigator.clipboard.writeText(url);
      } catch {
        /*
         * Clipboard API unavailable (older browser, insecure
         * context, etc.) — fall back to updating the URL bar
         * so the reader can still copy it manually.
         */
        history.pushState(null, '', `#${heading.id}`);
      }

      /*
       * Restart the animation even on rapid repeat clicks by
       * removing the class, forcing a reflow, then re-adding.
       */
      span.classList.remove('is-copied');
      void span.offsetWidth;
      span.classList.add('is-copied');

      window.clearTimeout(copyTimeout);
      copyTimeout = window.setTimeout(() => {
        span.classList.remove('is-copied');
      }, 1200);
    }

    heading.addEventListener('click', copyHeadingLink);
    heading.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        copyHeadingLink();
      }
    });
  });
</script>
<style>
   /*
   * =========================================================
   * ARTICLE
   * =========================================================
   */
  .article-page {
    position: relative;
  }
   .article-header {
     max-width: 52rem;
     padding:
      1rem 0
      3rem;
   }
   .article-header__category {
     margin-bottom: 1rem;
     font-family: var(--font-mono);
     font-size: 0.65rem;
     color: var(--accent);
     text-transform: uppercase;
     letter-spacing: 0.04em;
   }
   .article-header h1 {
     margin: 0;
     max-width: 18ch;
     font-size:
       clamp(2.4rem, 7vw, 4.5rem);
     line-height: 1.02;
     letter-spacing: -0.045em;
     font-weight: 600;
   }
   .article-header__description {
     max-width: 55ch;
     margin:
      1.5rem 0 0;
     color: var(--ink-soft);
     font-size: 1rem;
     line-height: 1.7;
   }
   .article-header__meta {
     display: flex;
     align-items: center;
     gap: 0.55rem;
     margin-top: 1.5rem;
     font-family: var(--font-mono);
     font-size: 0.62rem;
     color: var(--ink-soft);
     text-transform: uppercase;
   }
   .meta-separator {
     color: var(--mark);
   }
   /*
   * =========================================================
   * EXTERNAL PUBLICATION LINKS
   * =========================================================
   */
   .article-header__external {
     display: flex;
     flex-wrap: wrap;
     align-items: center;
     gap: 0.55rem;
     margin-top: 0.65rem;
     font-family: var(--font-mono);
     font-size: 0.62rem;
     color: var(--ink-soft);
     text-transform: uppercase;
     letter-spacing: 0.02em;
   }
   .article-header__external-label {
     color: var(--ink-soft);
     opacity: 0.7;
   }
   .article-header__external-link {
     color: var(--accent);
     text-decoration: none;
     border-bottom: 1px solid transparent;
     transition:
       border-color 0.15s ease,
       opacity 0.15s ease;
   }
   .article-header__external-link:hover {
     border-color: var(--accent);
   }
   /*
   * =========================================================
   * TAGS
   * =========================================================
   */
   .article-header__tags {
     display: flex;
     flex-wrap: wrap;
     gap: 0.45rem;
     margin-top: 1.25rem;
   }
   .article-tag {
     display: inline-block;
     padding:
      0.28rem 0.55rem;
     border:
      1px solid var(--line);
     color: var(--ink-soft);
     font-family: var(--font-mono);
     font-size: 0.6rem;
     text-decoration: none;
     transition:
       color 0.15s ease,
       border-color 0.15s ease,
       background 0.15s ease;
   }
   .article-tag:hover {
     color: var(--accent);
     border-color: var(--accent);
     background:
       color-mix(
         in srgb,
         var(--accent) 7%,
         transparent
       );
   }
   .article-divider {
     margin: 0;
     border: 0;
     border-top:
      1px solid var(--line);
   }
   /*
   * =========================================================
   * ARTICLE LAYOUT
   * =========================================================
   */
   .article-layout {
     position: relative;
     max-width: 52rem;
     padding:
      3rem 0 6rem;
   }
   .article-content {
     min-width: 0;
   }
   /*
   * =========================================================
   * CONTENT TYPOGRAPHY
   * =========================================================
   */
   .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    /*
     * Prevent the navbar from covering the heading
     * when navigating through the TOC.
     */
    scroll-margin-top: 6rem;
    font-weight: 600;
  }
   /*
   * Headings with an id are click-to-copy targets.
   */
   .article-content :global(h1[id]),
  .article-content :global(h2[id]),
  .article-content :global(h3[id]),
  .article-content :global(h4[id]) {
    cursor: pointer;
  }
   .article-content :global(h1[id]:focus-visible),
  .article-content :global(h2[id]:focus-visible),
  .article-content :global(h3[id]:focus-visible),
  .article-content :global(h4[id]:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 2px;
  }
   /*
   * -------------------------------------------------------
   * Heading marker bars.
   *
   * Each level sets --heading-bar-color once; the bar
   * border AND the copy-link underline both read from
   * that variable, so they're always guaranteed to match.
   * -------------------------------------------------------
   */
   .article-content :global(h1) {
     --heading-bar-color: var(--accent);
     margin:
      4rem 0 1.25rem;
     padding-left: 1.3rem;
     border-left: 5px solid var(--heading-bar-color);
     font-size: 2.5rem;
     line-height: 1.15;
     letter-spacing: -0.03em;
   }
   .article-content :global(h2) {
     --heading-bar-color: var(--mark);
     margin:
      3.5rem 0 1rem;
     padding-left: 1.1rem;
     border-left: 4px solid var(--heading-bar-color);
     font-size: 2rem;
     line-height: 1.2;
     letter-spacing: -0.025em;
   }
   .article-content :global(h3) {
     --heading-bar-color:
       color-mix(in srgb, var(--accent) 70%, transparent);
     margin:
      2.5rem 0 0.85rem;
     padding-left: 0.9rem;
     border-left: 3px solid var(--heading-bar-color);
     font-size: 1.45rem;
     line-height: 1.25;
   }
   .article-content :global(h4) {
     --heading-bar-color:
       color-mix(in srgb, var(--mark) 60%, transparent);
     margin:
      2rem 0 0.75rem;
     padding-left: 0.7rem;
     border-left: 2px solid var(--heading-bar-color);
     font-size: 1.15rem;
   }
   /*
   * -------------------------------------------------------
   * Copy-link underline sweep.
   * -------------------------------------------------------
   */
   .article-content :global(.heading-text) {
     position: relative;
     display: inline-block;
   }
   .article-content :global(.heading-text)::after {
     content: '';
     position: absolute;
     left: 0;
     bottom: -0.12em;
     width: 100%;
     height: 2px;
     background: var(--heading-bar-color, var(--accent));
     transform: scaleX(0);
     transform-origin: left;
     opacity: 0;
     pointer-events: none;
   }
   .article-content :global(.heading-text.is-copied)::after {
     animation: heading-copy-sweep 1.1s ease forwards;
   }
   @keyframes heading-copy-sweep {
     0% {
       transform: scaleX(0);
       opacity: 1;
     }
     45% {
       transform: scaleX(1);
       opacity: 1;
     }
     100% {
       transform: scaleX(1);
       opacity: 0;
     }
   }
   .article-content :global(p) {
     max-width: 68ch;
     margin:
      1rem 0;
     line-height: 1.8;
   }
   .article-content :global(ul),
  .article-content :global(ol) {
    max-width: 68ch;
    margin:
      1rem 0;
    padding-left: 1.5rem;
    line-height: 1.8;
  }
   .article-content :global(blockquote) {
     margin:
      1.5rem 0;
     padding-left: 1rem;
     border-left:
      2px solid var(--accent);
     color: var(--ink-soft);
   }
   .article-content :global(img) {
     display: block;
     max-width: 100%;
     height: auto;
     margin:
      2rem auto;
   }
   .article-content :global(pre) {
     overflow-x: auto;
     margin:
      1.5rem 0;
     padding: 1rem;
     border:
      1px solid var(--line);
     background:
       var(--paper-raised);
     font-size: 0.8rem;
     line-height: 1.6;
   }
   .article-content :global(code) {
     font-family: var(--font-mono);
   }
   /*
   * =========================================================
   * TABLE OF CONTENTS
   * =========================================================
   */
   .toc {
     position: fixed;
     left: 5.5rem;
     top: 50%;
     transform:
       translateY(-50%);
     z-index: 20;
   }
   /*
   * The small vertical marker rail.
   */
   .toc__toggle {
     display: flex;
     align-items: center;
     justify-content: center;
     width: 2.5rem;
     min-height: 9rem;
     padding:
      0.75rem 0.6rem;
     border: 0;
     border-radius: 0.7rem;
     background: transparent;
     cursor: pointer;
     transition:
       background 0.2s ease;
   }
   .toc__toggle:hover {
     background:
       color-mix(
         in srgb,
         var(--ink) 6%,
         transparent
       );
   }
   .toc__markers {
     display: flex;
     flex-direction: column;
     align-items: flex-end;
     justify-content: center;
     gap: 0.85rem;
     min-height: 11rem;
   }
   .toc__marker {
     display: block;
     width: 1.4rem;
     height: 2px;
     opacity: 0.28;
     border-radius:2px;
     transition:
       width 0.2s ease,
       opacity 0.2s ease,
       transform 0.2s ease;
   }
   /*
   * Interleaved marker colours.
   */
   .toc__marker--c1 {
     background: var(--accent);
   }
   .toc__marker--c2 {
     background: var(--mark);
   }
   .toc__toggle:hover .toc__marker {
     opacity: 0.7;
     width: 1.6rem;
   }
   /*
   * =========================================================
   * TOC PANEL
   * =========================================================
   */
   .toc__panel {
     position: absolute;
     left: 3rem;
     top: 50%;
     width: 15rem;
     max-height: 70vh;
     overflow-y: auto;
     padding:
      0.9rem;
     border:
      1px solid var(--line);
     border-radius: 0.75rem;
     background:
       color-mix(
         in srgb,
         var(--paper-raised) 92%,
         transparent
       );
     backdrop-filter: blur(12px);
     opacity: 0;
     visibility: hidden;
     transform:
       translateY(-50%)
       translateX(-0.5rem);
     transition:
       opacity 0.18s ease,
       visibility 0.18s ease,
       transform 0.18s ease;
   }
   .toc.is-open .toc__panel {
     opacity: 1;
     visibility: visible;
     transform:
       translateY(-50%)
       translateX(0);
   }
   .toc__title {
     margin-bottom: 0.65rem;
     padding-bottom: 0.55rem;
     border-bottom:
      1px solid var(--line);
     font-family: var(--font-mono);
     font-size: 0.58rem;
     color: var(--ink-soft);
     text-transform: uppercase;
     letter-spacing: 0.05em;
   }
   .toc__panel ol {
     list-style: none;
     margin: 0;
     padding: 0;
   }
   .toc__item {
     margin: 0;
   }
   .toc__item a {
     display: block;
     padding:
      0.35rem 0.45rem;
     border-radius: 0.4rem;
     color: var(--ink-soft);
     font-family: var(--font-mono);
     font-size: 0.62rem;
     line-height: 1.5;
     text-decoration: none;
     transition:
       color 0.15s ease,
       background 0.15s ease;
   }
   .toc__item a:hover {
     color: var(--ink);
     background:
       color-mix(
         in srgb,
         var(--ink) 6%,
         transparent
       );
   }
   .toc__item a.active {
     color: var(--accent);
     background:
       color-mix(
         in srgb,
         var(--accent) 8%,
         transparent
       );
   }
   /*
   * Indentation according to heading level.
   */
   .toc__item--level-2 {
     padding-left: 0.65rem;
   }
   .toc__item--level-3 {
     padding-left: 1.3rem;
   }
   .toc__item--level-4 {
     padding-left: 1.95rem;
   }
   /*
   * =========================================================
   * MOBILE
   * =========================================================
   */
   @media (max-width: 1100px) {
     .toc {
       left: 1rem;
     }
   }
   @media (max-width: 800px) {
     .toc {
       left: 0.5rem;
       top: auto;
       bottom: 1.25rem;
       transform: none;
     }
     .toc__toggle {
       min-height: 7rem;
     }
     .toc__markers {
       min-height: 7rem;
     }
     .toc__panel {
       left: 2.8rem;
       top: auto;
       bottom: 0;
