   */
   .article-content :global(.sidenote-toggle) {
     display: inline-block;
     cursor: pointer;
     font-family: var(--font-mono);
     font-size: 0.68rem;
     line-height: 0;
     vertical-align: super;
     color: var(--mark);
     padding: 0 0.2em;
     user-select: none;
     counter-increment: sidenote;
   }
   .article-content :global(.sidenote-toggle)::before {
