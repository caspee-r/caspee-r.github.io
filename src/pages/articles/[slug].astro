   .article-content :global(.sidenote-checkbox) {
     position: absolute;
     width: 1px;
     height: 1px;
     margin: -1px;
     padding: 0;
     overflow: hidden;
     clip: rect(0, 0, 0, 0);
     white-space: nowrap;
     border: 0;
   }
   .article-content :global(.sidenote-checkbox:focus-visible + .sidenote-toggle) {
