   * in-page "#heading" and relative "/articles/..." links
   * alone.
   */
   .article-content :global(a[href^="http"])::after {
     content: " ↗";
     display: inline-block;
     font-size: 0.85em;
     transform: translateY(-1px);
   }
   /*
   * -------------------------------------------------------
   * Tables.
   *
   * Flat hairline borders and a mono, uppercase header row —
   * matching the boxy, editorial treatment used for code
   * blocks and tags rather than the browser's default table
