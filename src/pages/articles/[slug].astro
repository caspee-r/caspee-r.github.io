---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculateReadingTime } from '../../lib/readingTime';
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: {
      slug: article.slug,
    },
    props: {
      article,
    },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
const readingTime = calculateReadingTime(article.body);
/*
 * The TOC is generated by Org and stored in the
 * article frontmatter.
 *
 * Expected shape:
 *
 * toc:
 *   - title: "The Idea Behind Interrupts"
 *     id: "the-idea-behind-interrupts"
 *     level: 1
 *
 *   - title: "Normal Device Events"
 *     id: "normal-device-events"
 *     level: 2
 */
const toc = article.data.toc ?? [];
const tags = article.data.tags ?? [];
/*
 * Optional list of places this article is also published,
 * e.g. Medium, Substack, dev.to.
 *
 * Expected shape:
 *
 * externalLinks:
 *   - label: "Medium"
 *     url: "https://medium.com/@you/your-article"
 */
const externalLinks = article.data.externalLinks ?? [];
---
<BaseLayout
  title={`${article.data.title}   Sami Dj`}
  description={article.data.description}
>
  <article class="article-page">
    <!-- =====================================================
    ARTICLE HEADER
    ===================================================== -->
    <header class="article-header">
      <div class="article-header__category">
        {article.data.category}
      </div>
      <h1>
        {article.data.title}
      </h1>
      {
        article.data.description && (
          <p class="article-header__description">
            {article.data.description}
          </p>
        )
      }
      <div class="article-header__meta">
        <time datetime={String(article.data.date)}>
          {new Date(article.data.date).toLocaleDateString('en', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
          }).toUpperCase()}
        </time>
        <span class="meta-separator">·</span>
        <span>
          {readingTime} min read
        </span>
      </div>
      {
        externalLinks.length > 0 && (
          <div class="article-header__external">
            <span class="article-header__external-label">
              Also on
            </span>
            {
externalLinks.map((link, index) => (
  <>
    <a
      href={link.url}
      target="_blank"
      rel="noopener noreferrer"
      class="article-header__external-link"
    >
      {link.label}
    </a>

    {index < externalLinks.length - 1 && (
      <span class="meta-separator"> </span>
    )}
  </>
))
            }
          </div>
        )
      }
      {
        tags.length > 0 && (
          <div class="article-header__tags">
            {
              tags.map((tag) => (
<span class="article-tag">
                  #{tag}
                </span>
              ))
            }
          </div>
        )
      }
    </header>
    <hr class="article-divider" />
    <!-- =====================================================
    ARTICLE CONTENT
    ===================================================== -->
    <div class="article-layout">
      <!-- ===================================================
      TABLE OF CONTENTS
      =================================================== -->
      {
        toc.length > 0 && (
          <aside class="toc" aria-label="Table of contents">
            <div class="toc__backdrop"></div>
            <button
              class="toc__toggle"
              type="button"
              aria-expanded="false"
              aria-label="Toggle table of contents"
            >
              <span class="toc__markers" aria-hidden="true">
                {
                  toc.map((_, index) => (
                    <span
                      class:list={{
                        "toc__marker": true,
                        "toc__marker--c1": index % 2 === 0,
                        "toc__marker--c2": index % 2 !== 0,
                      }}
                    />
                  ))
                }
              </span>
            </button>
            <nav class="toc__panel">
              <div class="toc__title">
                contents
              </div>
              <ol>
                {
                  toc.map((item) => (
                    <li
                      class:list={{
                        "toc__item": true,
                        [`toc__item--level-${item.level ?? 1}`]: true,
                      }}
                    >
                      <a href={`#${item.id}`}>
                        {item.title}
                      </a>
                    </li>
                  ))
                }
              </ol>
            </nav>
          </aside>
        )
      }
      <!-- ===================================================
      CONTENT
      =================================================== -->
      <div class="article-content">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
<script>
  /*
   * =========================================================
   * TABLE OF CONTENTS
   * =========================================================
   */
  const toc =
    document.querySelector<HTMLElement>('.toc');
  const toggle =
    document.querySelector<HTMLButtonElement>('.toc__toggle');
  const tocPanel =
    document.querySelector<HTMLElement>('.toc__panel');
  const tocBackdrop =
    document.querySelector<HTMLElement>('.toc__backdrop');

  if (toc && toggle && tocPanel) {
    /*
     * -------------------------------------------------------
     * Open / close
     * -------------------------------------------------------
     */
    toggle.addEventListener('click', () => {
      const open =
        toc.classList.toggle('is-open');
      toggle.setAttribute(
        'aria-expanded',
        String(open)
      );
    });

    /*
     * -------------------------------------------------------
     * Close when clicking outside
     * -------------------------------------------------------
     */
    document.addEventListener('click', (event) => {
      if (!toc.contains(event.target as Node)) {
        toc.classList.remove('is-open');
        toggle.setAttribute(
          'aria-expanded',
          'false'
        );
      }
    });

    /*
     * -------------------------------------------------------
     * Tapping the dimmed backdrop (mobile bottom-sheet mode)
     * also closes the panel.
     * -------------------------------------------------------
     */
    tocBackdrop?.addEventListener('click', () => {
      toc.classList.remove('is-open');
      toggle.setAttribute('aria-expanded', 'false');
    });

    /*
     * -------------------------------------------------------
     * Compute how much space the fixed/sticky navbar
     * actually needs right now, instead of trusting a
     * hardcoded magic number that can drift out of sync
     * with the real navbar height.
     *
     * NOTE: update the selector below to match your
     * BaseLayout's navbar markup if it differs.
     * -------------------------------------------------------
     */
    function getNavOffset(): number {
      const nav =
        document.querySelector<HTMLElement>('.nav');
      const height =
        nav?.getBoundingClientRect().height ?? 96;
      return height + 16; // small breathing room
    }

    function scrollToHeading(
      target: HTMLElement,
      smooth = true
    ) {
      const top =
        target.getBoundingClientRect().top +
        window.scrollY -
        getNavOffset();
      window.scrollTo({
        top,
        behavior: smooth ? 'smooth' : 'auto',
      });
    }

    /*
     * -------------------------------------------------------
     * Find headings represented by the TOC.
     * -------------------------------------------------------
     */
    const links =
      Array.from(
        tocPanel.querySelectorAll<HTMLAnchorElement>('a')
      );
    const headings =
      links
        .map((link) => {
        const id =
          link
            .getAttribute('href')
            ?.slice(1);
        return id
          ? document.getElementById(id)
          : null;
      })
        .filter(
          (heading): heading is HTMLElement =>
            heading !== null
        );

    /*
     * -------------------------------------------------------
     * Clicking a TOC link: scroll to the heading ourselves
     * with the correct navbar offset, instead of relying on
     * the browser's native #hash jump.
     *
     * Also closes the panel after selecting a heading.
     * -------------------------------------------------------
     */
    links.forEach((link) => {
      link.addEventListener('click', (event) => {
        const id =
          link
            .getAttribute('href')
            ?.slice(1);
        const target =
          id ? document.getElementById(id) : null;

        if (target) {
          event.preventDefault();
          scrollToHeading(target);
          history.pushState(null, '', `#${id}`);
        }

        toc.classList.remove('is-open');
        toggle.setAttribute(
          'aria-expanded',
          'false'
        );
      });
    });

    /*
     * -------------------------------------------------------
     * Landed directly on a URL that already has a hash:
     * correct the scroll position once layout has settled,
     * since the browser's initial jump ignores our offset.
     * -------------------------------------------------------
     */
    if (location.hash) {
      const initialTarget =
        document.getElementById(location.hash.slice(1));
      if (initialTarget) {
        requestAnimationFrame(() =>
          scrollToHeading(initialTarget, false)
        );
      }
    }

    /*
     * -------------------------------------------------------
     * Active heading
     * -------------------------------------------------------
     */
    if (headings.length > 0) {
      function updateActiveHeading() {
        const offset = getNavOffset();
        let active =
          headings[0];
        for (const heading of headings) {
          const top =
            heading.getBoundingClientRect().top;
          if (top <= offset) {
            active = heading;
          } else {
            break;
          }
        }
        links.forEach((link) => {
          const id =
            link
              .getAttribute('href')
              ?.slice(1);
          link.classList.toggle(
            'active',
            id === active.id
          );
        });
      }

      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateActiveHeading();
            ticking = false;
          });
        },
        { passive: true }
      );

      updateActiveHeading();
    }
  }

  /*
   * =========================================================
   * HEADING COPY-LINK (underline sweep)
   *
   * Clicking a heading copies a direct link to it. The only
   * feedback is a thin underline (matching that heading's
   * bar color) that sweeps under the heading text and fades
   * — no button, no icon, no tooltip.
   * =========================================================
   */
  const copyableHeadings =
    document.querySelectorAll<HTMLElement>(
      '.article-content h1[id], .article-content h2[id], .article-content h3[id], .article-content h4[id]'
    );

  copyableHeadings.forEach((heading) => {
    /*
     * Wrap the heading's existing content in a span so the
     * underline can be scoped to just the text width, rather
     * than stretching across the whole heading's flex box.
     */
    const span = document.createElement('span');
    span.className = 'heading-text';
    while (heading.firstChild) {
      span.appendChild(heading.firstChild);
    }
    heading.appendChild(span);

    heading.tabIndex = 0;
    heading.setAttribute('role', 'button');
    const label =
      heading.textContent?.trim() ?? 'section';
    heading.setAttribute(
      'aria-label',
      `Copy link to "${label}"`
    );

    let copyTimeout: number | undefined;

    async function copyHeadingLink() {
      const url =
        `${location.origin}${location.pathname}#${heading.id}`;

      try {
        await navigator.clipboard.writeText(url);
      } catch {
        /*
         * Clipboard API unavailable (older browser, insecure
         * context, etc.) — fall back to updating the URL bar
         * so the reader can still copy it manually.
         */
        history.pushState(null, '', `#${heading.id}`);
      }

      /*
       * Restart the animation even on rapid repeat clicks by
       * removing the class, forcing a reflow, then re-adding.
       */
      span.classList.remove('is-copied');
      void span.offsetWidth;
      span.classList.add('is-copied');

      window.clearTimeout(copyTimeout);
      copyTimeout = window.setTimeout(() => {
        span.classList.remove('is-copied');
      }, 1200);
    }

    heading.addEventListener('click', copyHeadingLink);
    heading.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        copyHeadingLink();
      }
    });
  });

  /*
   * =========================================================
   * IMAGE FRAMING
   *
   * Markdown/org content only ever gives us bare <img> tags.
   * Wrap each one in a bordered "frame" that matches the
   * site's hairline-border, boxy aesthetic, and turn the
   * title/alt text into a numbered caption (numbering itself
   * is handled purely in CSS via a counter). Images fade in
   * once loaded instead of popping in with layout shift.
   * =========================================================
   */
  const contentImages =
    document.querySelectorAll<HTMLImageElement>(
      '.article-content img'
    );

  contentImages.forEach((img) => {
    /*
     * Leave alone anything the author already wrapped in a
     * <figure> themselves, or explicitly opted out via
     * class="no-frame" (e.g. small inline icons/logos that
     * shouldn't get the full figure treatment).
     */
    if (img.closest('figure') || img.classList.contains('no-frame')) {
      return;
    }

    const captionText =
      img.getAttribute('title') || img.getAttribute('alt') || '';

    const figure = document.createElement('figure');
    figure.className = 'article-figure';

    const frame = document.createElement('div');
    frame.className = 'article-figure__frame';

    const parent = img.parentElement;

    /*
     * Markdown wraps a standalone image in its own <p>. If
     * that <p> contains nothing but the image, replace the
     * whole paragraph with the figure instead of nesting a
     * block-level figure inside it.
     */
    const isSoloInParagraph =
      parent?.tagName === 'P' && parent.children.length === 1;

    const anchorParent =
      isSoloInParagraph ? parent!.parentElement : parent;
    const anchorNode: ChildNode | null =
      isSoloInParagraph ? parent! : img;

    anchorParent?.insertBefore(figure, anchorNode);
    frame.appendChild(img);
    figure.appendChild(frame);

    if (captionText) {
      const figcaption = document.createElement('figcaption');
      figcaption.textContent = captionText;
      figure.appendChild(figcaption);
    }

    if (isSoloInParagraph) {
      parent?.remove();
    }

    img.loading = img.loading || 'lazy';
    img.decoding = 'async';

    const markLoaded = () => img.classList.add('is-loaded');
    if (img.complete) {
      markLoaded();
    } else {
      img.addEventListener('load', markLoaded, { once: true });
      img.addEventListener('error', markLoaded, { once: true });
    }
  });

  /*
   * Note: margin notes (sidenotes) no longer need a client-side
   * build step here. They're now the <Sidenote> Astro component
   * (see src/components/Sidenote.astro), which renders the
   * checkbox/label/text wrapper directly in the static HTML —
   * either written by hand in MDX or generated automatically
   * from Org footnotes by the export pipeline. Only the CSS
   * below (the .sidenote-* rules) is still needed to drive the
   * show/hide and the wide-screen float-into-the-margin layout.
   */
</script>
<style>
   /*
   * =========================================================
   * ARTICLE TYPEFACE
   *
   * "Et Bembo" refers to ET Book — the free, open-source
   * typeface designed to stand in for Bembo (a commercial
   * Monotype face with no web-license path), built for and
   * used throughout Edward Tufte's own handouts and books.
   * It's scoped to .article-page only, and only overrides
   * --font-serif locally — every place in this file that
   * explicitly uses var(--font-mono) for labels, dates, tags,
   * captions, code, and the TOC is untouched, so the
   * mono/serif contrast that carries the rest of the site's
   * look is preserved within articles too.
   * =========================================================
   */
   @font-face {
   font-family: 'et-book';
   src: url('/fonts/et-book-roman-line-figures.ttf') format('truetype');
   font-weight: 400;
   font-style: normal;
   font-display: swap;
   }

@font-face {
font-family: 'et-book';
src: url('/fonts/et-book-display-italic-old-style-figures.ttf') format('truetype');
font-weight: 400;
font-style: italic;
font-display: swap;
}

@font-face {
font-family: 'et-book';
src: url('/fonts/et-book-bold-line-figures.ttf') format('truetype');
font-weight: 700;
font-style: normal;
font-display: swap;
}
   /*
   * =========================================================
   * ARTICLE
   * =========================================================
   */
  .article-page {
    position: relative;
    --font-serif:
      'et-book', 'Source Serif 4', Palatino,
      'Palatino Linotype', Georgia, serif;
    font-family: var(--font-serif);
  }
   /*
   * Give the article page more breathing room than the site's
   * general 42rem column — and, above the two-column breakpoint
   * further down, room for an actual reserved sidenote column,
   * not just wider body text. 66rem = the 52rem reading column
   * + a 2rem gutter + a 12rem sidenote track. Below that
   * breakpoint this simply has no effect beyond the wider body
   * text, since .article-layout stays single-column and there's
   * nothing to reserve room for yet.
   * This is scoped to :global(.main) inside this page's own
   * stylesheet, which Astro only bundles onto pages that
   * actually render this component — so it widens .main here
   * without touching the homepage, /articles, or /projects.
   */
   :global(.main) {
     max-width: 66rem;
   }
   .article-header {
     max-width: 52rem;
     padding:
      1rem 0
      3rem;
   }
   .article-header__category {
     margin-bottom: 1rem;
     font-family: var(--font-mono);
     font-size: 0.65rem;
     color: var(--accent);
     text-transform: uppercase;
     letter-spacing: 0.04em;
   }
   .article-header h1 {
     margin: 0;
     max-width: 18ch;
     font-size:
       clamp(2.4rem, 7vw, 4.5rem);
     line-height: 1.02;
     letter-spacing: -0.045em;
     font-weight: 600;
   }
   .article-header__description {
     max-width: 55ch;
     margin:
      1.5rem 0 0;
     color: var(--ink-soft);
     font-size: 1rem;
     line-height: 1.7;
   }
   .article-header__meta {
     display: flex;
     align-items: center;
     gap: 0.6rem;
     margin-top: 1.5rem;
     font-family: var(--font-mono);
     font-size: 0.82rem;
     color:
       color-mix(in srgb, var(--ink-soft) 65%, var(--ink) 35%);
     text-transform: uppercase;
     letter-spacing: 0.03em;
   }
   .meta-separator {
     color: var(--mark);
   }
   /*
   * =========================================================
   * EXTERNAL PUBLICATION LINKS
   * =========================================================
   */
   .article-header__external {
     display: flex;
     flex-wrap: wrap;
     align-items: center;
     gap: 0.55rem;
     margin-top: 0.65rem;
     font-family: var(--font-mono);
     font-size: 0.62rem;
     color: var(--ink-soft);
     text-transform: uppercase;
     letter-spacing: 0.02em;
   }
   .article-header__external-label {
     color: var(--ink-soft);
     opacity: 0.7;
   }
   .article-header__external-link {
     color: var(--accent);
     text-decoration: none;
     border-bottom: 1px solid transparent;
     transition:
       border-color 0.15s ease,
       opacity 0.15s ease;
   }
   .article-header__external-link:hover {
     border-color: var(--accent);
   }
   /*
   * =========================================================
   * TAGS
   * =========================================================
   */
   .article-header__tags {
     display: flex;
     flex-wrap: wrap;
     gap: 0.45rem;
     margin-top: 1.25rem;
   }
   .article-tag {
     display: inline-block;
     padding:
      0.28rem 0.55rem;
     border:
      1px solid var(--line);
     color: var(--ink-soft);
     font-family: var(--font-mono);
     font-size: 0.6rem;
     cursor: default;
   }
   .article-divider {
     margin: 0;
     border: 0;
     border-top:
      1px solid var(--line);
   }
   /*
   * =========================================================
   * ARTICLE LAYOUT
   * =========================================================
   */
   .article-layout {
     position: relative;
     max-width: 52rem;
     padding:
      3rem 0 6rem;
   }
   /*
   * Above the shared 1250px breakpoint (see the TOC and
   * sidenote sections below — both switch in lockstep with
   * this), the layout becomes a real two-column grid: the
   * reading column, plus a genuinely reserved 12rem sidenote
   * track with a 2rem gutter between them. Nothing is placed
   * in that second column directly — sidenotes are still deeply
   * nested inside paragraphs in column one — but because the
   * track itself is real and fixed-width now, the sidenote's
   * float/negative-margin only has to match that one fixed,
   * known number, rather than a guess at ambient viewport
   * whitespace. That's what actually fixes the "how much
   * screen do I have" guessing game from before.
   */
   @media (min-width: 1250px) {
     .article-layout {
       max-width: 66rem;
       display: grid;
       grid-template-columns: minmax(0, 1fr) 12rem;
       column-gap: 2rem;
     }
   }
   .article-content {
     min-width: 0;
     font-size: 1.0625rem;
     counter-reset: figure sidenote;
   }
   /*
   * =========================================================
   * CONTENT TYPOGRAPHY
   * =========================================================
   */
   .article-content :global(h1),
  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    /*
     * Prevent the navbar from covering the heading
     * when navigating through the TOC.
     */
    scroll-margin-top: 6rem;
    font-weight: 600;
  }
   /*
   * Headings with an id are click-to-copy targets.
   */
   .article-content :global(h1[id]),
  .article-content :global(h2[id]),
  .article-content :global(h3[id]),
  .article-content :global(h4[id]) {
    cursor: pointer;
  }
   .article-content :global(h1[id]:focus-visible),
  .article-content :global(h2[id]:focus-visible),
  .article-content :global(h3[id]:focus-visible),
  .article-content :global(h4[id]:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 2px;
  }
   /*
   * -------------------------------------------------------
   * Heading marker bars.
   *
   * Each level sets --heading-bar-color once; the bar
   * border AND the copy-link underline both read from
   * that variable, so they're always guaranteed to match.
   * -------------------------------------------------------
   */
   .article-content :global(h1) {
     --heading-bar-color: var(--accent);
     margin:
      4rem 0 1.25rem;
     padding-left: 1.3rem;
     border-left: 5px solid var(--heading-bar-color);
     font-size: 2.5rem;
     line-height: 1.15;
     letter-spacing: -0.03em;
   }
   .article-content :global(h2) {
     --heading-bar-color: var(--mark);
     margin:
      3.5rem 0 1rem;
     padding-left: 1.1rem;
     border-left: 4px solid var(--heading-bar-color);
     font-size: 2rem;
     line-height: 1.2;
     letter-spacing: -0.025em;
   }
   .article-content :global(h3) {
     --heading-bar-color:
       color-mix(in srgb, var(--accent) 70%, transparent);
     margin:
      2.5rem 0 0.85rem;
     padding-left: 0.9rem;
     border-left: 3px solid var(--heading-bar-color);
     font-size: 1.45rem;
     line-height: 1.25;
   }
   .article-content :global(h4) {
     --heading-bar-color:
       color-mix(in srgb, var(--mark) 60%, transparent);
     margin:
      2rem 0 0.75rem;
     padding-left: 0.7rem;
     border-left: 2px solid var(--heading-bar-color);
     font-size: 1.15rem;
   }
   /*
   * -------------------------------------------------------
   * Copy-link underline sweep.
   * -------------------------------------------------------
   */
   .article-content :global(.heading-text) {
     position: relative;
     display: inline-block;
   }
   .article-content :global(.heading-text)::after {
     content: '';
     position: absolute;
     left: 0;
     bottom: -0.12em;
     width: 100%;
     height: 2px;
     background: var(--heading-bar-color, var(--accent));
     transform: scaleX(0);
     transform-origin: left;
     opacity: 0;
     pointer-events: none;
   }
   .article-content :global(.heading-text.is-copied)::after {
     animation: heading-copy-sweep 1.1s ease forwards;
   }
   @keyframes heading-copy-sweep {
     0% {
       transform: scaleX(0);
       opacity: 1;
     }
     45% {
       transform: scaleX(1);
       opacity: 1;
     }
     100% {
       transform: scaleX(1);
       opacity: 0;
     }
   }
   .article-content :global(p) {
     max-width: 68ch;
     margin:
      1rem 0;
     line-height: 1.8;
   }
   .article-content :global(ul),
  .article-content :global(ol) {
