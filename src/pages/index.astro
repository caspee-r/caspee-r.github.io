---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = [
  {
    name: 'schema-diff',
    desc: 'A CLI that turns two database schemas into a plain-English changelog instead of a wall of SQL.',
    href: 'https://github.com/yourname/schema-diff',
  },
  {
    name: 'docs-lint',
    desc: 'A linter for prose in technical docs — catches unexplained jargon, dead links, and stale code samples.',
    href: 'https://github.com/yourname/docs-lint',
  },
];

function formatDate(date: Date): string {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, '0');
  return `${year}.${month}`;
}

const allArticles = await getCollection('articles', ({ data }) => {
  return data.draft !== true;
});

const recentArticles = allArticles
  .sort(
    (a, b) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )
  .slice(0, 3)
  .map((article) => ({
    date: formatDate(new Date(article.data.date)),
    title: article.data.title,
    dek: article.data.description,
    href: `/articles/${article.slug}/`,
  }));
---
<BaseLayout title="Sami Djellabi — Software Engineer & Technical Writer">
  <section class="identity">
    <div class="name">
      <span class="index">01</span>
      <h1>Sami<br>Djellabi</h1>
    </div>

    <p class="role">
      Software engineer<br>
      <span>Technical writer</span>
    </p>
  </section>

  <p class="bio">
    I build backend tools and internal platforms — the kind of software
    that's supposed to be boring, and mostly is, until it isn't. I write
    about whatever breaks that assumption.
  </p>

  <section class="list-section" aria-labelledby="work-heading">
    <span class="annot">selected work</span>
    <h2 id="work-heading" class="visually-hidden">Selected work</h2>
    <ul class="entries">
      {projects.map((p) => (
        <li class="entry">
          <a class="entry__link" href={p.href} target="_blank" rel="noopener noreferrer">
            <div class="entry__head">
              <h3>{p.name}</h3>
              <span class="entry__arrow" aria-hidden="true">→</span>
            </div>
            <p>{p.desc}</p>
          </a>
        </li>
      ))}
    </ul>
    <a class="all-link" href="/projects">All projects →</a>
  </section>

  <section class="list-section" aria-labelledby="writing-heading">
    <span class="annot">selected writing</span>
    <h2 id="writing-heading" class="visually-hidden">Writing</h2>
    <ul class="entries">
      {recentArticles.map((a) => (
        <li class="entry">
          <a class="entry__link" href={a.href}>
            <div class="entry__head entry__head--article">
              <time class="entry__date">{a.date}</time>
              <h3>{a.title}</h3>
            </div>
            <p>{a.dek}</p>
          </a>
        </li>
      ))}
    </ul>
    <a class="all-link" href="/articles">All articles →</a>
  </section>
</BaseLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .identity {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: end;
  }

  .name {
    display: flex;
    gap: 2.5rem;
    align-items: flex-start;
  }

  .index {
    margin-top: 0.7rem;
    font-family: monospace;
    font-size: 0.7rem;
    opacity: 0.4;
  }

  h1 {
    margin: 0;
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: 0.8;
    letter-spacing: -0.08em;
  }

  .role {
    margin: 0 0 0.4rem;
    font-family: monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    opacity: 0.6;
  }

  .role span {
    opacity: 0.7;
  }

  .bio {
    max-width: 46ch;
    margin: 2.25rem 0 0;
    color: var(--ink-soft);
    font-size: 1rem;
    line-height: 1.75;
  }

  .list-section {
    margin-bottom: 3.5rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .entry { border-bottom: 1px solid var(--line); }
  .entry:first-child { border-top: 1px solid var(--line); }

  .entry__link {
    display: block;
    text-decoration: none;
    color: inherit;
    padding: 1.25rem 0;
    transition: background 0.15s ease;
  }
  .entry__link:hover,
  .entry__link:focus-visible {
    background: var(--paper-raised);
  }

  .entry__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .entry__head--article { justify-content: flex-start; gap: 1rem; }

  .entry h3 {
    font-family: var(--font-mono);
    font-size: 0.98rem;
    font-weight: 600;
    margin: 0;
    color: var(--ink);
  }

  .entry__date {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--mark);
    flex: none;
  }

  .entry__arrow {
    font-family: var(--font-mono);
    color: var(--ink-soft);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .entry__link:hover .entry__arrow {
    transform: translateX(3px);
    color: var(--accent);
  }

  .entry p {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    max-width: var(--measure);
  }

  .all-link {
    display: inline-block;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .all-link:hover, .all-link:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .identity {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      align-items: start;
    }

    .name {
      gap: 1.25rem;
    }

    .index {
      margin-top: 0.5rem;
    }

    h1 {
      font-size: clamp(3rem, 15vw, 4.5rem);
    }

    .bio {
      margin-top: 1.5rem;
      font-size: 0.95rem;
    }

    .entry__head {
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .entry__head--article {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
  }
</style>
