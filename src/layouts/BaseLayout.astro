---
import Nav from '../components/Nav.astro';
import SocialRail from '../components/SocialRail.astro';
import EmailRail from '../components/EmailRail.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Software engineer and technical writer.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
    rel="stylesheet"
  />
  <script is:inline>
    (function () {
      var stored = localStorage.getItem('theme');
      if (stored === 'dark' || stored === 'light') {
        document.documentElement.setAttribute('data-theme', stored);
      }
    })();
  </script>
</head>
<body id="top">
  <a href="#main-content" class="skip-link">Skip to content</a>
  <div class="frame">
    <Nav />
    <SocialRail />
    <main class="main" id="main-content" tabindex="-1">
      <slot />
    </main>
    <EmailRail />
    <footer class="foot">
      <div class="foot__identity">
	<span class="foot__motto">still curious.</span>

	<span>
	  © {new Date().getFullYear()} sami dj
	</span>
      </div>

      <div class="foot__links">
	<a href="https://github.com/caspr">github</a>
	<span aria-hidden="true">·</span>
	<a href="/rss.xml">rss</a>
	<span aria-hidden="true">·</span>
	<span>built with Astro</span>
      </div>

      <a href="#top" class="foot__top">
	↑ top
      </a>
    </footer>
  </div>
</body>
</html>

<style is:global>
  :root {
    --paper: #eef0ea;
    --paper-raised: #e6e9dd;
    --ink: #1c1e19;
    --ink-soft: #5a5d4c;
    --accent: #2e5b4c;
    --mark: #a13d2b;
    --line: #d2d5c2;

    --font-mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --font-serif: 'Source Serif 4', Georgia, 'Times New Roman', serif;

    --measure: 60ch;
    --rail-w: 4.5rem;

    color-scheme: light;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #15170f;
      --paper-raised: #1e2117;
      --ink: #ecefe1;
      --ink-soft: #9a9d86;
      --accent: #74b79c;
      --mark: #e58a67;
      --line: #2e3125;
      color-scheme: dark;
    }
  }

  :root[data-theme="dark"] {
    --paper: #15170f;
    --paper-raised: #1e2117;
    --ink: #ecefe1;
    --ink-soft: #9a9d86;
    --accent: #74b79c;
    --mark: #e58a67;
    --line: #2e3125;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }

  html {
    background: var(--paper);
    color: var(--ink);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    transition: background 0.15s ease, color 0.15s ease;
  }

  a { color: inherit; }

  ::selection {
    background: var(--mark);
    color: var(--paper);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .skip-link {
    position: absolute;
    top: -3rem;
    left: 1rem;
    z-index: 100;
    background: var(--accent);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.6rem 1rem;
    border-radius: 3px;
    text-decoration: none;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
      scroll-behavior: auto !important;
    }
  }

  .frame {
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr) var(--rail-w);
    grid-template-areas:
      "nav    nav    nav"
      "social main   email"
      "foot   foot   foot";
    min-height: 100vh;
  }

  .main {
    grid-area: main;
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 6rem;
  }

.foot {
  grid-area: foot;
  border-top: 1px solid var(--line);
  padding: 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;

  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--ink-soft);
}

.foot__identity {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.foot__motto {
  color: var(--accent);
  font-family: var(--font-serif);
  font-size: 0.95rem;
  font-style: italic;
}

.foot__links {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.foot a {
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid var(--line);
}

.foot a:hover {
  color: var(--accent);
  border-color: var(--accent);
}

.foot__top {
  white-space: nowrap;
}

@media (max-width: 600px) {
  .foot {
    align-items: flex-start;
    flex-direction: column;
  }

  .foot__links {
    flex-wrap: wrap;
  }

  .foot__top {
    margin-top: 0.5rem;
  }
}
  .annot {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--mark);
    letter-spacing: 0.01em;
    margin-bottom: 0.6rem;
  }
  .annot::before { content: "// "; opacity: 0.7; }

  @media (max-width: 860px) {
    .frame {
      grid-template-columns: 1fr;
      grid-template-areas:
        "nav"
        "social"
        "main"
        "email"
        "foot";
    }
    .main { padding: 2.25rem 1.25rem 4rem; }
  }

  @media (max-width: 480px) {
    .main { padding: 1.75rem 1rem 3rem; }
    .foot { padding: 1.25rem 1rem; }
  }
